namespace AVRegularity.CycleComparison.Coarse

/-! The edge part of the response-flux identity, one source component at a time: the pairings of
a target component with the covariance polynomial of each source contribution add up to the
pairing with the covariance polynomial of the edge flux adjoint. -/

section Pair
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- Finite additivity of the cell pairing in the test field, for an `L²` field paired with
continuous test fields. -/
theorem cellInner_finsetSum_right {κ : Type*} (S : Finset κ) {g : Vec 2 → E}
    (hg : MemLp g 2 (volume.restrict AVenhance.unitCube)) {f : κ → Vec 2 → E}
    (hf : ∀ c ∈ S, Continuous (f c)) :
    cellInner g (fun x => ∑ c ∈ S, f c x) = ∑ c ∈ S, cellInner g (f c) := by
  unfold cellInner
  simp_rw [inner_sum]
  exact integral_finsetSum S fun c hc => integrable_inner_continuous hg (hf c hc)

end Pair

variable {ι : Type*} [Fintype ι] {h : ι → Type*} [∀ i, NormedAddCommGroup (h i)]
  [∀ i, InnerProductSpace ℝ (h i)] [∀ i, FiniteDimensional ℝ (h i)]

/-- The edge flux adjoint, with the source components summed first. -/
theorem edgeFluxAdjoint_eq_sum (D H : ℕ)
    (CE : ℕ → ∀ (v u : ι) (d : Finset.Icc 2 D), ℝ → Vec 2 →
      (PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => h u)) →L[ℝ]
        (PiLp 2 (fun _ : Fin 2 => h v)))
    (t : ℝ) (ψ : ∀ v, Vec 2 → PiLp 2 (fun _ : Fin 2 => h v)) (u : ι) :
    edgeFluxAdjoint D H CE t ψ u = fun x => ∑ v : ι, ∑ r ∈ Finset.Icc 1 H, ∑ d : Finset.Icc 2 D,
      wordAdjoint (d.1 - 1) (fun y => ContinuousLinearMap.adjoint (CE r v u d t y) (ψ v y)) x := by
  funext x
  exact Finset.sum_comm (s := Finset.Icc 1 H) (t := (Finset.univ : Finset ι))

omit [∀ i, FiniteDimensional ℝ (h i)] in
/-- **The edge pairings add up.** -/
theorem edge_pairing_sum (Hc : Matrix (Fin 2) (Fin 2) ℝ) (p : ℕ) (inr : ι → ∀ u, Vec 2 → h u)
    (hinr : ∀ v u, ContDiff ℝ ((2 * p : ℕ) : ℕ∞) (inr v u))
    (hcont : ∀ v u, Continuous (covPolyP Hc p (inr v u))) (V : ∀ u, Vec 2 → h u)
    (hV : ∀ u, MemLp (V u) 2 (volume.restrict AVenhance.unitCube)) :
    ∑ u : ι, ∑ v : ι, cellInner (V u) (covPolyP Hc p (inr v u)) =
      ∑ u : ι, cellInner (V u) (covPolyP Hc p (fun x => ∑ v : ι, inr v u x)) := by
  refine Finset.sum_congr rfl fun u _ => ?_
  have e : (fun x => ∑ v : ι, inr v u x) = ∑ v : ι, inr v u := by
    funext x; rw [Finset.sum_apply]
  rw [e, covLin_covPolyP_sum Hc p Finset.univ fun v _ => hinr v u]
  have e2 : (∑ v : ι, covPolyP Hc p (inr v u)) = fun x => ∑ v : ι, covPolyP Hc p (inr v u) x := by
    funext x; rw [Finset.sum_apply]
  rw [e2, cellInner_finsetSum_right _ (hV u) fun v _ => hcont v u]

end AVRegularity.CycleComparison.Coarse
end

section
open MeasureTheory Homogenization AVRegularity.Sobolev
open scoped ENNReal
namespace AVRegularity.CycleComparison.Coarse

/-! One piece of a response flux: the formal adjoint, at each time of the window, of a family of
test-field operators applied to a continuous Sobolev field. If the adjoints are uniformly bounded
and the operators act jointly measurably in time and space, the piece is square integrable in time
and pairs with every smooth periodic test field as the field pairs with the operator. -/

section
variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E] [BorelSpace E]
  [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
  [MeasurableSpace F] [BorelSpace F]

/-- **One adjoint piece of a response flux.** -/
theorem adjPiece_exists {t₀ t₁ : ℝ} (h01 : t₀ ≤ t₁) {K K' m R Kc : ℕ} {C : ℝ}
    (hK : K + m ≤ Kc) (hK' : K + m ≤ K')
    {U : ℝ → TorusHk K' E} (hU : ContinuousOn U (Set.Icc t₀ t₁))
    {T : ℝ → (Vec 2 → F) → (Vec 2 → E)}
    (A : ∀ s ∈ Set.Icc t₀ t₁, TorusAdj (T s) m R Kc C)
    (hT : ∀ ψ : Vec 2 → F, ContDiff ℝ (⊤ : ℕ∞) ψ → AVenhance.IsZ2Periodic ψ →
      JointlyMeas t₀ t₁ fun s => T s ψ) :
    ∃ G : ℝ → TorusHk K F, MemLp G 2 (volume.restrict (Set.Icc t₀ t₁)) ∧
      AEStronglyMeasurable G (volume.restrict (Set.Icc t₀ t₁)) ∧
      (∃ M : ℝ, ∀ s ∈ Set.Icc t₀ t₁, ‖G s‖ ≤ M) ∧
      ∀ s ∈ Set.Icc t₀ t₁, ∀ ψ : Vec 2 → F, ContDiff ℝ (⊤ : ℕ∞) ψ →
        AVenhance.IsZ2Periodic ψ →
        cellInner (tval (G s)) ψ = cellInner (tval (U s)) (T s ψ) := by
  classical
  set I := Set.Icc t₀ t₁
  let Ut : ℝ → TorusHk (K + m) E := fun s => truncateTorusHk hK' (U s)
  have hUt : ContinuousOn Ut I := (truncateTorusHk hK').continuous.comp_continuousOn hU
  let G : ℝ → TorusHk K F := fun s => if hs : s ∈ I then (A s hs).adj K hK (Ut s) else 0
  have hident : ∀ s ∈ I, ∀ ψ : Vec 2 → F, ContDiff ℝ (⊤ : ℕ∞) ψ →
      AVenhance.IsZ2Periodic ψ →
      cellInner (tval (G s)) ψ = cellInner (tval (U s)) (T s ψ) := by
    intro s hs ψ hψ hp
    have hG : G s = (A s hs).adj K hK (Ut s) := by simp only [G, hs, dite_true]
    rw [hG, (A s hs).ident K hK (Ut s) ψ (hψ.of_le (by exact_mod_cast le_top)) hp]
    simp only [Ut, tval_truncateTorusHk]
  -- measurability
  have hmeas : AEStronglyMeasurable G (volume.restrict I) := by
    refine aestronglyMeasurable_of_adjoint_pairing measurableSet_Icc hUt (T := T)
      (fun ψ hψ hp => (hT ψ hψ hp).aestronglyMeasurable_prod h01) (fun s hs ψ hψ hp => ?_)
      (fun s hs ψ hψ hp => by rw [hident s hs ψ hψ hp]; simp only [Ut, tval_truncateTorusHk])
    exact ((A s hs).maps 0 (Nat.zero_le _) ψ (hψ.of_le (by exact_mod_cast le_top)) hp).1.continuous
  -- boundedness
  obtain ⟨M, hM⟩ := isCompact_Icc.exists_bound_of_continuousOn hU
  have hb : ∀ s ∈ I, ‖G s‖ ≤ C * M := by
    intro s hs
    have hG : G s = (A s hs).adj K hK (Ut s) := by simp only [G, hs, dite_true]
    rw [hG]
    have hC : 0 ≤ C := (ContinuousLinearMap.opNorm_nonneg _).trans ((A s hs).bound K hK)
    calc ‖(A s hs).adj K hK (Ut s)‖ ≤ ‖(A s hs).adj K hK‖ * ‖Ut s‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ C * ‖U s‖ := mul_le_mul ((A s hs).bound K hK) (truncateTorusHk_norm_le hK' (U s))
          (norm_nonneg _) hC
      _ ≤ C * M := mul_le_mul_of_nonneg_left (hM s hs) hC
  exact ⟨G, memLp_two_of_bound measurableSet_Icc measure_Icc_lt_top hmeas hb, hmeas, ⟨_, hb⟩,
    hident⟩
end

/-! A response flux assembled from adjoint pieces: a diagonal piece for each component (from the
first predecessor) and an edge piece for each pair of components (from the second predecessor).
The flux is square integrable in time and pairs with every family of smooth periodic test fields
as the predecessors pair with the diagonal and edge operators. -/

section
section Sum
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [CompleteSpace E]

theorem cellInner_tval_finsetSum {K : ℕ} {κ : Type*} (S : Finset κ) (U : κ → TorusHk K E)
    {ψ : Vec 2 → E} (hψ : Continuous ψ) :
    cellInner (tval (∑ c ∈ S, U c)) ψ = ∑ c ∈ S, cellInner (tval (U c)) ψ := by
  classical
  induction S using Finset.induction_on with
  | empty => simp [cellInner_tval_zero]
  | insert a S ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, cellInner_tval_add _ _ hψ, ih]

omit [MeasurableSpace E] [BorelSpace E] [CompleteSpace E] in
theorem cellInner_zero_left (ψ : Vec 2 → E) : cellInner (fun _ => (0 : E)) ψ = 0 := by
  simp [cellInner]

end Sum

variable {ι : Type*} [Fintype ι] {h : ι → Type*} [∀ i, NormedAddCommGroup (h i)]
  [∀ i, InnerProductSpace ℝ (h i)] [∀ i, FiniteDimensional ℝ (h i)] [∀ i, MeasurableSpace (h i)]
  [∀ i, BorelSpace (h i)] [∀ i, CompleteSpace (h i)]
  {F : ι → Type*} [∀ i, NormedAddCommGroup (F i)] [∀ i, InnerProductSpace ℝ (F i)]
  [∀ i, FiniteDimensional ℝ (F i)] [∀ i, MeasurableSpace (F i)] [∀ i, BorelSpace (F i)]
  [∀ i, CompleteSpace (F i)]

/-- **A response flux from adjoint pieces.** -/
theorem cellFlux_of_adj {t₀ t₁ : ℝ} (h01 : t₀ ≤ t₁) {K K1 K2 mD mE RD RE KcD KcE : ℕ}
    {CD : ℝ} {CE : ι → ι → ℝ} (hKD : K + mD ≤ KcD) (hKE : K + mE ≤ KcE) (n1 n2 : ℕ)
    (hK1 : n1 ≠ 0 → K + mD ≤ K1) (hK2 : n2 ≠ 0 → K + mE ≤ K2)
    (U' : ∀ v, ℝ → TorusHk K1 (h v)) (U'' : ∀ v, ℝ → TorusHk K2 (h v))
    (hU' : n1 ≠ 0 → ∀ v, ContinuousOn (U' v) (Set.Icc t₀ t₁))
    (hU'' : n2 ≠ 0 → ∀ v, ContinuousOn (U'' v) (Set.Icc t₀ t₁))
    (TD : ∀ v, ℝ → (Vec 2 → F v) → (Vec 2 → h v))
    (TE : ∀ v u, ℝ → (Vec 2 → F v) → (Vec 2 → h u))
    (AD : ∀ v, ∀ s ∈ Set.Icc t₀ t₁, TorusAdj (TD v s) mD RD KcD CD)
    (AE : ∀ v u, ∀ s ∈ Set.Icc t₀ t₁, TorusAdj (TE v u s) mE RE KcE (CE v u))
    (hTD : ∀ v (ψ : Vec 2 → F v), ContDiff ℝ (⊤ : ℕ∞) ψ → AVenhance.IsZ2Periodic ψ →
      JointlyMeas t₀ t₁ fun s => TD v s ψ)
    (hTE : ∀ v u (ψ : Vec 2 → F v), ContDiff ℝ (⊤ : ℕ∞) ψ → AVenhance.IsZ2Periodic ψ →
      JointlyMeas t₀ t₁ fun s => TE v u s ψ) :
    ∃ G : ∀ v, ℝ → TorusHk K (F v), (∀ v, MemLp (G v) 2 (volume.restrict (Set.Icc t₀ t₁))) ∧
      ∀ s ∈ Set.Icc t₀ t₁, ∀ ψ : ∀ v, Vec 2 → F v, (∀ v, ContDiff ℝ (⊤ : ℕ∞) (ψ v)) →
        (∀ v, AVenhance.IsZ2Periodic (ψ v)) →
        ∑ v, cellInner (tval (G v s)) (ψ v) =
          ∑ v, cellInner ((if n1 = 0 then fun _ _ _ => 0 else fun v s x => tval (U' v s) x) v s)
              (TD v s (ψ v))
            + ∑ u, ∑ v, cellInner
              ((if n2 = 0 then fun _ _ _ => 0 else fun v s x => tval (U'' v s) x) u s)
              (TE v u s (ψ v)) := by
  classical
  set I := Set.Icc t₀ t₁
  -- the diagonal pieces
  have hD : ∀ v, ∃ G : ℝ → TorusHk K (F v), AEStronglyMeasurable G (volume.restrict I) ∧
      (∃ M : ℝ, ∀ s ∈ I, ‖G s‖ ≤ M) ∧ ∀ s ∈ I, ∀ ψ : Vec 2 → F v, ContDiff ℝ (⊤ : ℕ∞) ψ → AVenhance.IsZ2Periodic ψ →
        cellInner (tval (G s)) ψ =
          cellInner ((if n1 = 0 then fun _ _ _ => 0 else fun v s x => tval (U' v s) x) v s)
            (TD v s ψ) := by
    intro v
    by_cases hn : n1 = 0
    · refine ⟨fun _ => 0, aestronglyMeasurable_const, ⟨0, fun _ _ => by simp⟩,
        fun s _ ψ _ _ => ?_⟩
      simp only [hn, ↓reduceIte, cellInner_tval_zero, cellInner_zero_left]
    · obtain ⟨G, -, hG, hGb, hid⟩ := adjPiece_exists h01 hKD (hK1 hn) (hU' hn v) (AD v) (hTD v)
      refine ⟨G, hG, hGb, fun s hs ψ hψ hp => ?_⟩
      rw [hid s hs ψ hψ hp]
      simp only [hn, ↓reduceIte]
  have hE : ∀ v u, ∃ G : ℝ → TorusHk K (F v), AEStronglyMeasurable G (volume.restrict I) ∧
      (∃ M : ℝ, ∀ s ∈ I, ‖G s‖ ≤ M) ∧ ∀ s ∈ I, ∀ ψ : Vec 2 → F v, ContDiff ℝ (⊤ : ℕ∞) ψ → AVenhance.IsZ2Periodic ψ →
        cellInner (tval (G s)) ψ =
          cellInner ((if n2 = 0 then fun _ _ _ => 0 else fun v s x => tval (U'' v s) x) u s)
            (TE v u s ψ) := by
    intro v u
    by_cases hn : n2 = 0
    · refine ⟨fun _ => 0, aestronglyMeasurable_const, ⟨0, fun _ _ => by simp⟩,
        fun s _ ψ _ _ => ?_⟩
      simp only [hn, ↓reduceIte, cellInner_tval_zero, cellInner_zero_left]
    · obtain ⟨G, -, hG, hGb, hid⟩ := adjPiece_exists h01 hKE (hK2 hn) (hU'' hn u) (AE v u) (hTE v u)
      refine ⟨G, hG, hGb, fun s hs ψ hψ hp => ?_⟩
      rw [hid s hs ψ hψ hp]
      simp only [hn, ↓reduceIte]
  choose GD hGDm hGDb hGD using hD
  choose GE hGEm hGEb hGE using hE
  have hmem : ∀ v, MemLp (fun s => GD v s + ∑ u, GE v u s) 2 (volume.restrict I) := by
    intro v
    obtain ⟨M₀, hM₀⟩ := hGDb v
    choose M hM using hGEb v
    refine memLp_two_of_bound measurableSet_Icc measure_Icc_lt_top
      ((hGDm v).add (Finset.aestronglyMeasurable_fun_sum _ fun u _ => hGEm v u))
      (M := M₀ + ∑ u, M u) fun s hs => ?_
    refine (norm_add_le _ _).trans (add_le_add (hM₀ s hs) ?_)
    exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun u _ => hM u s hs)
  refine ⟨fun v s => GD v s + ∑ u, GE v u s, hmem, fun s hs ψ hψ hp => ?_⟩
  have hv : ∀ v, cellInner (tval (GD v s + ∑ u, GE v u s)) (ψ v) =
      cellInner ((if n1 = 0 then fun _ _ _ => 0 else fun v s x => tval (U' v s) x) v s)
          (TD v s (ψ v)) +
        ∑ u, cellInner ((if n2 = 0 then fun _ _ _ => 0 else fun v s x => tval (U'' v s) x) u s)
          (TE v u s (ψ v)) := by
    intro v
    rw [cellInner_tval_add _ _ (hψ v).continuous, cellInner_tval_finsetSum _ _ (hψ v).continuous,
      hGD v s hs (ψ v) (hψ v) (hp v)]
    congr 1
    exact Finset.sum_congr rfl fun u _ => hGE v u s hs (ψ v) (hψ v) (hp v)
  rw [Finset.sum_congr rfl fun v _ => hv v, Finset.sum_add_distrib, Finset.sum_comm (s := Finset.univ)
    (t := Finset.univ)]
end

/-! Uniform-in-time bounds extracted from the coarse setting: the covariance matrix entries are at
most `ρ²` on the window, and a coefficient of finite seminorm has bounded derivative arrays
through its order, uniformly in time and space. -/

/-- Entries of a matrix field are bounded by its sup norm on the window. -/
theorem abs_entry_le_of_matrixSupNorm {M : ℝ → Matrix (Fin 2) (Fin 2) ℝ} {t₀ t₁ c : ℝ}
    (hc : 0 ≤ c) (h : matrixSupNorm M t₀ t₁ ≤ ENNReal.ofReal c) {s : ℝ} (hs : s ∈ Set.Icc t₀ t₁)
    (i j : Fin 2) : |M s i j| ≤ c := by
  have h1 : ENNReal.ofReal |M s i j| ≤ matrixSupNorm M t₀ t₁ := by
    unfold matrixSupNorm
    exact le_iSup₂_of_le s hs (le_iSup_of_le i (le_iSup_of_le j le_rfl))
  exact (ENNReal.ofReal_le_ofReal_iff hc).1 (h1.trans h)

/-- A coefficient of finite seminorm has bounded derivative arrays through its order. -/
theorem coeffArray_bound_of_seminorm {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] {ρ : ℝ} (hρ : 0 < ρ) {K : ℕ} {t₀ t₁ : ℝ}
    {A : ℝ → Vec 2 → E →L[ℝ] F} (hA : coefficientSeminorm ρ K t₀ t₁ A ≠ ⊤) {j : ℕ} (hj : j ≤ K) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ t ∈ Set.Icc t₀ t₁, ∀ x, ‖coefficientDerivativeArray (A t) j x‖ ≤ M := by
  set S : ℝ≥0∞ := ⨆ t ∈ Set.Icc t₀ t₁, ⨆ x : Vec 2,
    (‖coefficientDerivativeArray (A t) j x‖₊ : ℝ≥0∞) with hS
  have hw : 0 < ρ ^ j / (j.factorial : ℝ) := by positivity
  have hterm : ENNReal.ofReal (ρ ^ j / (j.factorial : ℝ)) * S ≤ coefficientSeminorm ρ K t₀ t₁ A := by
    unfold coefficientSeminorm
    exact Finset.single_le_sum (f := fun j => ENNReal.ofReal (ρ ^ j / (j.factorial : ℝ)) *
      ⨆ t ∈ Set.Icc t₀ t₁, ⨆ x : Vec 2,
        (‖coefficientDerivativeArray (A t) j x‖₊ : ℝ≥0∞)) (fun _ _ => zero_le)
      (Finset.mem_range.2 (by omega))
  have hfin : S ≠ ⊤ := by
    intro htop
    rw [htop, ENNReal.mul_top (by simpa using hw)] at hterm
    exact hA (top_le_iff.1 hterm)
  refine ⟨S.toReal, ENNReal.toReal_nonneg, fun t ht x => ?_⟩
  have h1 : (‖coefficientDerivativeArray (A t) j x‖₊ : ℝ≥0∞) ≤ S :=
    le_iSup₂_of_le t ht (le_iSup_of_le x le_rfl)
  have h2 := ENNReal.toReal_mono hfin h1
  simpa using h2

end AVRegularity.CycleComparison.Coarse
end

section
open MeasureTheory Homogenization AVRegularity.Sobolev AVRegularity.Weighted
open scoped ENNReal
namespace AVRegularity.CycleComparison.Coarse

/-! Uniform-in-time bounds on the derivatives of the drift components through the order `N`,
from the bound and the normalized jets of the drift in the coarse setting. -/

/-- The ordered derivatives of the drift coefficient are the ordered derivatives of the drift
components. -/
theorem orderedCoeff_driftCoefficient_apply {v : Vec 2 → Vec 2} {l : ℕ}
    (hv : ContDiff ℝ (l : ℕ) v) (w : DerivativeWord2 l) (x : Vec 2) (k : Fin 2) :
    orderedCoefficientDerivative (driftCoefficient v) l w x
        (WithLp.toLp 2 (Pi.single k (1 : ℝ))) =
      orderedScalarDerivative (fun y => v y k) l w x := by
  have hsum := orderedCoefficientDerivative_finset_sum Finset.univ
    (fun (k' : Fin 2) (y : Vec 2) => v y k' • PiLp.proj 2 (fun _ : Fin 2 => ℝ) k') l
    (fun k' _ => (contDiff_pi.mp hv k').smul_const _) w
  have e : driftCoefficient v = fun y => ∑ k' : Fin 2, v y k' • PiLp.proj 2 (fun _ : Fin 2 => ℝ) k' :=
    rfl
  rw [e, hsum]
  simp only [FunLike.coe_sum, Finset.sum_apply]
  rw [Finset.sum_eq_single k]
  · rw [congrFun (orderedCoefficientDerivative_smul_const (fun y => v y k) l
      (contDiff_pi.mp hv k) _ w) x]
    simp
  · intro k' _ hk'
    rw [congrFun (orderedCoefficientDerivative_smul_const (fun y => v y k') l
      (contDiff_pi.mp hv k') _ w) x]
    simp [hk'.symm]
  · intro h; exact absurd (Finset.mem_univ k) h

/-- An ordered derivative of a coefficient is bounded by its derivative array. -/
theorem norm_orderedCoeff_le_array {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] (C : Vec 2 → E →L[ℝ] F) (l : ℕ)
    (w : DerivativeWord2 l) (x : Vec 2) :
    ‖orderedCoefficientDerivative C l w x‖ ≤ ‖coefficientDerivativeArray C l x‖ := by
  refine ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _) fun e => ?_
  have h1 : orderedCoefficientDerivative C l w x e = coefficientDerivativeArray C l x e w := rfl
  rw [h1]
  exact (PiLp.norm_apply_le _ w).trans ((coefficientDerivativeArray C l x).le_opNorm e)

/-- The derivatives of a component are bounded by the derivative array of the drift
coefficient. -/
theorem norm_iteratedFDeriv_component_le {v : Vec 2 → Vec 2} {l : ℕ}
    (hv : ContDiff ℝ (l : ℕ) v) (k : Fin 2) (x : Vec 2) :
    ‖iteratedFDeriv ℝ l (fun y => v y k) x‖ ≤
      2 ^ l * ‖coefficientDerivativeArray (driftCoefficient v) l x‖ := by
  have hvk : ContDiff ℝ (l : ℕ) (fun y => v y k) := contDiff_pi.mp hv k
  refine (norm_le_sum_basisVec _).trans ?_
  have hterm : ∀ w : DerivativeWord2 l,
      ‖iteratedFDeriv ℝ l (fun y => v y k) x (fun i => basisVec (w i))‖ ≤
        ‖coefficientDerivativeArray (driftCoefficient v) l x‖ := by
    intro w
    have e1 : iteratedFDeriv ℝ l (fun y => v y k) x (fun i => basisVec (w i)) =
        orderedScalarDerivative (fun y => v y k) l (fun i => w i.rev) x := by
      rw [orderedScalarDerivative_eq_iterated _ l hvk]
      simp
    rw [e1, ← orderedCoeff_driftCoefficient_apply hv]
    refine ((orderedCoefficientDerivative (driftCoefficient v) l _ x).le_opNorm _).trans ?_
    have hn : ‖(WithLp.toLp 2 (Pi.single k (1 : ℝ)) : PiLp 2 (fun _ : Fin 2 => ℝ))‖ = 1 := by
      change ‖PiLp.single 2 (β := fun _ : Fin 2 => ℝ) k (1 : ℝ)‖ = 1
      rw [PiLp.norm_single]; simp
    rw [hn, mul_one]
    exact norm_orderedCoeff_le_array _ l _ x
  calc ∑ w : DerivativeWord2 l, ‖iteratedFDeriv ℝ l (fun y => v y k) x (fun i => basisVec (w i))‖
      ≤ ∑ _w : DerivativeWord2 l, ‖coefficientDerivativeArray (driftCoefficient v) l x‖ :=
        Finset.sum_le_sum fun w _ => hterm w
    _ = 2 ^ l * ‖coefficientDerivativeArray (driftCoefficient v) l x‖ := by
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
        simp [DerivativeWord2]

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {h : ι → Type*}
  [∀ i, NormedAddCommGroup (h i)] [∀ i, InnerProductSpace ℝ (h i)]
  {t₀ t₁ ρ B a B₀ lam : ℝ} {b : ℝ → Vec 2 → Vec 2} {D H p J k L N : ℕ}
  {Jm : ℝ → Matrix (Fin 2) (Fin 2) ℝ}
  {AD : ∀ d : Finset.Icc 2 D, ℝ → Vec 2 →
    PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => ℝ) →L[ℝ] PiLp 2 (fun _ : Fin 2 => ℝ)}
  {CE : ℕ → ∀ (v u : ι) (d : Finset.Icc 2 D), ℝ → Vec 2 →
    (PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => h u)) →L[ℝ] (PiLp 2 (fun _ : Fin 2 => h v))}
  {π : ι → ℝ} {Aedge : Matrix ι ι ℝ} {Cstar Θ : ℝ}

/-- **Uniform drift bounds**: the derivatives of the drift components through the order `N`
are bounded uniformly in time and space on the window. -/
theorem drift_component_bound
    (P : IsCoarseSetting t₀ t₁ ρ B a B₀ lam b D H p J k L N Jm AD CE π Aedge Cstar Θ)
    {l : ℕ} (hl : l ≤ N) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ s ∈ Set.Icc t₀ t₁, ∀ x (k' : Fin 2),
      ‖iteratedFDeriv ℝ l (fun y => b s y k') x‖ ≤ M := by
  rcases Nat.eq_zero_or_pos l with rfl | hl1
  · obtain ⟨C, hC⟩ := P.drift_bdd
    refine ⟨max C 0, le_max_right _ _, fun s hs x k' => ?_⟩
    rw [norm_iteratedFDeriv_zero]
    exact ((norm_le_pi_norm (b s x) k').trans (hC s hs x)).trans (le_max_left _ _)
  · refine ⟨2 ^ l * max (a * B₀ ^ l * (l.factorial : ℝ) * lam ^ ((1 : ℤ) - l)) 0,
      by positivity, fun s hs x k' => ?_⟩
    have hv : ContDiff ℝ (l : ℕ) (b s) := (P.drift_smooth s hs).of_le (by exact_mod_cast le_top)
    refine (norm_iteratedFDeriv_component_le hv k' x).trans ?_
    gcongr
    exact (P.drift_jets l hl1 hl s hs x).trans (le_max_left _ _)

/-- The iterated derivative of a planar field is bounded by those of its components. -/
theorem norm_iteratedFDeriv_le_sum_components {f : Vec 2 → Vec 2} {n : ℕ}
    (hf : ContDiff ℝ (n : ℕ) f) (x : Vec 2) :
    ‖iteratedFDeriv ℝ n f x‖ ≤ ∑ k : Fin 2, ‖iteratedFDeriv ℝ n (fun y => f y k) x‖ := by
  refine ContinuousMultilinearMap.opNorm_le_bound
    (Finset.sum_nonneg fun _ _ => norm_nonneg _) fun m => ?_
  refine (pi_norm_le_iff_of_nonneg (by positivity)).2 fun k => ?_
  have e : iteratedFDeriv ℝ n (fun y => f y k) x =
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 2 => ℝ) k).compContinuousMultilinearMap
        (iteratedFDeriv ℝ n f x) := by
    have := (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 2 => ℝ) k).iteratedFDeriv_comp_left
      (hf.contDiffAt (x := x)) (i := n) (by exact_mod_cast le_rfl)
    simpa [Function.comp_def] using this
  have h1 : iteratedFDeriv ℝ n f x m k = iteratedFDeriv ℝ n (fun y => f y k) x m := by
    rw [e]; rfl
  rw [h1]
  refine ((iteratedFDeriv ℝ n (fun y => f y k) x).le_opNorm m).trans ?_
  gcongr
  exact Finset.single_le_sum (f := fun k => ‖iteratedFDeriv ℝ n (fun y => f y k) x‖)
    (fun _ _ => norm_nonneg _) (Finset.mem_univ k)

/-- **Uniform drift bounds, vector form.** -/
theorem drift_bound
    (P : IsCoarseSetting t₀ t₁ ρ B a B₀ lam b D H p J k L N Jm AD CE π Aedge Cstar Θ)
    {l : ℕ} (hl : l ≤ N) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ s ∈ Set.Icc t₀ t₁, ∀ x, ‖iteratedFDeriv ℝ l (b s) x‖ ≤ M := by
  obtain ⟨M, hM0, hM⟩ := drift_component_bound P hl
  refine ⟨2 * M, by positivity, fun s hs x => ?_⟩
  have hv : ContDiff ℝ (l : ℕ) (b s) := (P.drift_smooth s hs).of_le (by exact_mod_cast le_top)
  refine (norm_iteratedFDeriv_le_sum_components hv x).trans ?_
  calc ∑ k : Fin 2, ‖iteratedFDeriv ℝ l (fun y => b s y k) x‖ ≤ ∑ _k : Fin 2, M :=
        Finset.sum_le_sum fun k _ => hM s hs x k
    _ = 2 * M := by simp

end AVRegularity.CycleComparison.Coarse
end

section
open MeasureTheory Homogenization AVRegularity.Sobolev
namespace AVRegularity.CycleComparison.Coarse

/-! The finite causal coarse family from the response fluxes: if, for every cell `(i, j)`, any
continuous predecessors have a square-integrable response flux, then the whole family of genuine
second-order energy solutions exists (each response from the coupled energy theorem
`coupled_energy_torus`, the family glued causally in `i + j`). -/

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {h : ι → Type*}
  [∀ i, NormedAddCommGroup (h i)] [∀ i, InnerProductSpace ℝ (h i)]
  [∀ i, FiniteDimensional ℝ (h i)] [∀ i, MeasurableSpace (h i)] [∀ i, BorelSpace (h i)]
  [∀ i, CompleteSpace (h i)]

section
variable (ι h)

/-- The data of one cell: responses, their gradients carriers, and fluxes. -/
abbrev CellData (k J H L : ℕ) (i j : ℕ) : Type _ :=
  (∀ v : ι, ℝ → TorusHk (coarseSlot k J H L i j) (h v)) ×
    (∀ v : ι, ℝ → TorusHk (coarseSlot k J H L i j + 1) (h v)) ×
    (∀ v : ι, ℝ → TorusHk (coarseSlot k J H L i j) (PiLp 2 (fun _ : Fin 2 => h v)))

instance (k J H L i j : ℕ) : Inhabited (CellData ι h k J H L i j) :=
  ⟨(fun _ _ => 0, fun _ _ => 0, fun _ _ => 0)⟩

end

/-- The value field of the first predecessor (zero at `i = 0`). -/
def predVal1 {k J H L : ℕ} (i j : ℕ) (U' : ∀ v : ι, ℝ → TorusHk (coarseSlot k J H L (i - 1) j) (h v)) :
    ∀ v : ι, ℝ → Vec 2 → h v :=
  if i = 0 then fun _ _ _ => 0
  else fun v s x => (U' v s).toFunction.jet (valueIndex2 (coarseSlot k J H L (i - 1) j)) x

/-- The value field of the second predecessor (zero at `j = 0`). -/
def predVal2 {k J H L : ℕ} (i j : ℕ) (U'' : ∀ v : ι, ℝ → TorusHk (coarseSlot k J H L i (j - 1)) (h v)) :
    ∀ v : ι, ℝ → Vec 2 → h v :=
  if j = 0 then fun _ _ _ => 0
  else fun v s x => (U'' v s).toFunction.jet (valueIndex2 (coarseSlot k J H L i (j - 1))) x

/-- **The response flux of one cell** (a conditional input): continuous predecessors have a
square-integrable flux solving the response-flux identity. -/
def HasCellFlux (t₀ t₁ : ℝ) (b : ℝ → Vec 2 → Vec 2) (D H p k J L : ℕ)
    (AD : ∀ d : Finset.Icc 2 D, ℝ → Vec 2 →
      PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => ℝ) →L[ℝ] PiLp 2 (fun _ : Fin 2 => ℝ))
    (CE : ℕ → ∀ (v u : ι) (d : Finset.Icc 2 D), ℝ → Vec 2 →
      (PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => h u)) →L[ℝ]
        (PiLp 2 (fun _ : Fin 2 => h v)))
    (Hcov : ℝ → Matrix (Fin 2) (Fin 2) ℝ) (i j : ℕ) : Prop :=
  ∀ (U' : ∀ v : ι, ℝ → TorusHk (coarseSlot k J H L (i - 1) j) (h v))
    (U'' : ∀ v : ι, ℝ → TorusHk (coarseSlot k J H L i (j - 1)) (h v)),
    (i ≠ 0 → ∀ v, ContinuousOn (U' v) (Set.Icc t₀ t₁)) →
    (j ≠ 0 → ∀ v, ContinuousOn (U'' v) (Set.Icc t₀ t₁)) →
    ∃ G : ∀ v : ι, ℝ → TorusHk (coarseSlot k J H L i j) (PiLp 2 (fun _ : Fin 2 => h v)),
      (∀ v, MemLp (G v) 2 (volume.restrict (Set.Icc t₀ t₁))) ∧
      IsCoarseResponseFlux t₀ t₁ b D H p AD CE Hcov (coarseSlot k J H L i j) G
        (predVal1 i j U') (predVal2 i j U'')

variable {t₀ t₁ ρ B a B₀ lam : ℝ} {b : ℝ → Vec 2 → Vec 2} {D H p J k L N : ℕ}
  {Jm : ℝ → Matrix (Fin 2) (Fin 2) ℝ}
  {AD : ∀ d : Finset.Icc 2 D, ℝ → Vec 2 →
    PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => ℝ) →L[ℝ] PiLp 2 (fun _ : Fin 2 => ℝ)}
  {CE : ℕ → ∀ (v u : ι) (d : Finset.Icc 2 D), ℝ → Vec 2 →
    (PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => h u)) →L[ℝ] (PiLp 2 (fun _ : Fin 2 => h v))}
  {π : ι → ℝ} {Aedge : Matrix ι ι ℝ} {Cstar Θ : ℝ}

/-- **The coarse family from the cell fluxes.** -/
theorem coarseResponses_of_cellFlux
    (P : IsCoarseSetting t₀ t₁ ρ B a B₀ lam b D H p J k L N Jm AD CE π Aedge Cstar Θ)
    (hflux : ∀ i, i ≤ J → ∀ j, j ≤ H →
      HasCellFlux t₀ t₁ b D H p k J L AD CE (covarianceMatrix Jm B t₀) i j)
    (f : ∀ v, TorusHk N (h v)) :
    ∃ (U : ∀ (i j : ℕ) (v : ι), ℝ → TorusHk (coarseSlot k J H L i j) (h v))
      (Uw : ∀ (i j : ℕ) (v : ι), ℝ → TorusHk (coarseSlot k J H L i j + 1) (h v))
      (G : ∀ (i j : ℕ) (v : ι), ℝ → TorusHk (coarseSlot k J H L i j)
        (PiLp 2 (fun _ : Fin 2 => h v))),
      IsCoarseResponses t₀ t₁ B b D H p k J L N AD CE (covarianceMatrix Jm B t₀) f U Uw G := by
  classical
  set Hcov := covarianceMatrix Jm B t₀
  set X : ℕ → ℕ → Type _ := fun i j => CellData ι h k J H L i j
  -- the cell relation
  let Good : ∀ i j, X i j → Prop := fun _ _ x => ∀ v, ContinuousOn (x.1 v) (Set.Icc t₀ t₁)
  let Rel : ∀ i j, X (i - 1) j → X i (j - 1) → X i j → Prop := fun i j x₁ x₂ x =>
    i ≤ J → j ≤ H →
      ∃ f₀ : ∀ v, TorusHk (coarseSlot k J H L i j) (h v),
        (if i = 0 ∧ j = 0 then
          ∀ v, (f₀ v).toFunction.jet (valueIndex2 (coarseSlot k J H L i j))
            =ᵐ[volume.restrict AVenhance.unitCube] (f v).toFunction.jet (valueIndex2 N)
         else ∀ v, f₀ v = 0) ∧
        IsCoupledWeakSolutionTorus B t₀ t₁ b 2 (fun _ => coarseSlot k J H L i j)
          (fun _ _ _ _ _ => 0) f₀ x.2.2 (fun _ _ => 0) x.1 x.2.1 ∧
        IsCoarseResponseFlux t₀ t₁ b D H p AD CE Hcov (coarseSlot k J H L i j) x.2.2
          (predVal1 i j x₁.1) (predVal2 i j x₂.1)
  -- one step can always be made
  have hex : ∀ i j (x₁ : X (i - 1) j) (x₂ : X i (j - 1)), (i ≠ 0 → Good (i - 1) j x₁) →
      (j ≠ 0 → Good i (j - 1) x₂) → ∃ x : X i j, Good i j x ∧ Rel i j x₁ x₂ x := by
    intro i j x₁ x₂ h₁ h₂
    by_cases hij : i ≤ J ∧ j ≤ H
    · obtain ⟨G, hG, hGflux⟩ := hflux i hij.1 j hij.2 x₁.1 x₂.1 h₁ h₂
      have hKN := coarseSlot_le_input k J H L N i j P.N_eq
      let f₀ : ∀ v, TorusHk (coarseSlot k J H L i j) (h v) :=
        if i = 0 ∧ j = 0 then fun v => truncateTorusHk hKN (f v) else fun _ => 0
      obtain ⟨u, w, hsol⟩ := secondOrderResponse_exists P (coarseSlot k J H L i j) hKN f₀ G hG
      refine ⟨(u, w, G), hsol.1, fun _ _ => ⟨f₀, ?_, hsol, hGflux⟩⟩
      by_cases h00 : i = 0 ∧ j = 0
      · simp only [h00, and_self, ↓reduceIte, f₀]
        intro v
        exact Filter.EventuallyEq.of_eq (tval_truncateTorusHk hKN (f v))
      · simp only [h00, ↓reduceIte, f₀]
        exact fun _ => trivial
    · refine ⟨default, fun v => continuousOn_const, fun hi hj => absurd ⟨hi, hj⟩ hij⟩
  let step : ∀ i j, X (i - 1) j → X i (j - 1) → X i j := fun i j x₁ x₂ =>
    if hg : (i ≠ 0 → Good (i - 1) j x₁) ∧ (j ≠ 0 → Good i (j - 1) x₂) then
      Classical.choose (hex i j x₁ x₂ hg.1 hg.2) else default
  have hstep : ∀ i j x₁ x₂, (i ≠ 0 → Good (i - 1) j x₁) → (j ≠ 0 → Good i (j - 1) x₂) →
      Good i j (step i j x₁ x₂) ∧ Rel i j x₁ x₂ (step i j x₁ x₂) := by
    intro i j x₁ x₂ h₁ h₂
    have hg : (i ≠ 0 → Good (i - 1) j x₁) ∧ (j ≠ 0 → Good i (j - 1) x₂) := ⟨h₁, h₂⟩
    change Good i j (dite _ _ _) ∧ Rel i j x₁ x₂ (dite _ _ _)
    split_ifs
    exact Classical.choose_spec (hex i j x₁ x₂ hg.1 hg.2)
  have hspec := glue_spec Good Rel step hstep
  set F := glue step
  refine ⟨fun i j => (F i j).1, fun i j => (F i j).2.1, fun i j => (F i j).2.2, ?_⟩
  intro i hi j hj
  obtain ⟨f₀, hf₀, hsol, hfl⟩ := (hspec i j).2 hi hj
  refine ⟨f₀, hf₀, hsol, ?_⟩
  have e1 : predVal1 i j (glueFst F i j).1 =
      (if i = 0 then fun _ _ _ => 0 else fun v s x => ((F (i - 1) j).1 v s).toFunction.jet
        (valueIndex2 (coarseSlot k J H L (i - 1) j)) x) := by
    by_cases hi0 : i = 0
    · simp [predVal1, hi0]
    · simp only [predVal1, hi0, ↓reduceIte, glueFst_of_ne F hi0]
  have e2 : predVal2 i j (glueSnd F i j).1 =
      (if j = 0 then fun _ _ _ => 0 else fun v s x => ((F i (j - 1)).1 v s).toFunction.jet
        (valueIndex2 (coarseSlot k J H L i (j - 1))) x) := by
    by_cases hj0 : j = 0
    · simp [predVal2, hj0]
    · simp only [predVal2, hj0, ↓reduceIte, glueSnd_of_ne F i hj0]
  rw [e1, e2] at hfl
  exact hfl

end AVRegularity.CycleComparison.Coarse
end
end
end

section
@[expose] public noncomputable section
section
open MeasureTheory Homogenization AVRegularity.Sobolev
open scoped ENNReal
namespace AVRegularity.CycleComparison.Coarse

/-! Uniform-in-time bound functions for the response-flux constants: the covariance bound `4ρ²`,
a bound on `Jm`, drift derivative bounds `Bb`, and derivative-array bounds `BA`, `BE` of the
diagonal and edge coefficients (the edge coefficients extended by zero outside `1 ≤ r ≤ H`). -/

section
variable {ι : Type*} [Fintype ι] [DecidableEq ι] {h : ι → Type*}
  [∀ i, NormedAddCommGroup (h i)] [∀ i, InnerProductSpace ℝ (h i)]
  {t₀ t₁ ρ B a B₀ lam : ℝ} {b : ℝ → Vec 2 → Vec 2} {D H p J k L N : ℕ}
  {Jm : ℝ → Matrix (Fin 2) (Fin 2) ℝ}
  {AD : ∀ d : Finset.Icc 2 D, ℝ → Vec 2 →
    PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => ℝ) →L[ℝ] PiLp 2 (fun _ : Fin 2 => ℝ)}
  {CE : ℕ → ∀ (v u : ι) (d : Finset.Icc 2 D), ℝ → Vec 2 →
    (PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => h u)) →L[ℝ] (PiLp 2 (fun _ : Fin 2 => h v))}
  {π : ι → ℝ} {Aedge : Matrix ι ι ℝ} {Cstar Θ : ℝ}

section
variable (P : IsCoarseSetting t₀ t₁ ρ B a B₀ lam b D H p J k L N Jm AD CE π Aedge Cstar Θ)
include P

/-- The covariance bound on the window. -/
theorem covBound_le {s : ℝ} (hs : s ∈ Set.Icc t₀ t₁) :
    covBound (covarianceMatrix Jm B t₀ s) ≤ 4 * ρ ^ 2 := by
  have he : ∀ i j, |covarianceMatrix Jm B t₀ s i j| ≤ ρ ^ 2 := fun i j =>
    abs_entry_le_of_matrixSupNorm (sq_nonneg ρ) P.cov_small hs i j
  unfold covBound
  calc ∑ i, ∑ j, |covarianceMatrix Jm B t₀ s i j| ≤ ∑ _i : Fin 2, ∑ _j : Fin 2, ρ ^ 2 :=
        Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => he i j
    _ = 4 * ρ ^ 2 := by simp; ring

/-- A bound on the entries of `Jm` on the window. -/
theorem jm_bound : ∃ M : ℝ, ∀ t ∈ Set.Icc t₀ t₁, ∀ i j, |Jm t i j| ≤ M := by
  set S := (matrixSupNorm (fun t => Jm t - B • (1 : Matrix (Fin 2) (Fin 2) ℝ)) t₀ t₁).toReal
  have hS : matrixSupNorm (fun t => Jm t - B • (1 : Matrix (Fin 2) (Fin 2) ℝ)) t₀ t₁ ≤
      ENNReal.ofReal S := by rw [ENNReal.ofReal_toReal P.J_bdd]
  refine ⟨S + |B|, fun t ht i j => ?_⟩
  have h1 := abs_entry_le_of_matrixSupNorm ENNReal.toReal_nonneg hS ht i j
  have h2 : |(B • (1 : Matrix (Fin 2) (Fin 2) ℝ)) i j| ≤ |B| := by
    rw [Matrix.smul_apply, smul_eq_mul, abs_mul]
    by_cases hij : i = j
    · simp [Matrix.one_apply, hij]
    · simp [hij]
  calc |Jm t i j| = |(Jm t - B • (1 : Matrix (Fin 2) (Fin 2) ℝ)) i j +
        (B • (1 : Matrix (Fin 2) (Fin 2) ℝ)) i j| := by simp
    _ ≤ |(Jm t - B • (1 : Matrix (Fin 2) (Fin 2) ℝ)) i j| +
        |(B • (1 : Matrix (Fin 2) (Fin 2) ℝ)) i j| := abs_add_le _ _
    _ ≤ S + |B| := add_le_add h1 h2

/-- Drift bounds `‖D^{l+1} b‖ ≤ Bb l` for `l + 1 ≤ N`. -/
theorem exists_drift_bounds : ∃ Bb : ℕ → ℝ, ∀ l, l + 1 ≤ N → ∀ s ∈ Set.Icc t₀ t₁, ∀ x,
    ‖iteratedFDeriv ℝ (l + 1) (b s) x‖ ≤ Bb l := by
  have h := fun l (hl : l + 1 ≤ N) => drift_bound P hl
  choose M _ hM using h
  exact ⟨fun l => if hl : l + 1 ≤ N then M l hl else 0, fun l hl s hs x => by
    simp only [hl, dite_true]; exact hM l hl s hs x⟩

/-- Derivative-array bounds of the diagonal coefficients through the order `N`. -/
theorem exists_diag_bounds : ∃ BA : ℕ → ℕ → ℝ, ∀ d : Finset.Icc 2 D, ∀ l, l ≤ N →
    ∀ s ∈ Set.Icc t₀ t₁, ∀ x, ‖coefficientDerivativeArray (AD d s) l x‖ ≤ BA d.1 l := by
  have h := fun (d : Finset.Icc 2 D) l (hl : l ≤ N) =>
    coeffArray_bound_of_seminorm P.rho_pos (P.AD_fin d) hl
  choose M _ hM using h
  refine ⟨fun dn l => if hd : dn ∈ Finset.Icc 2 D ∧ l ≤ N then M ⟨dn, hd.1⟩ l hd.2 else 0,
    fun d l hl s hs x => ?_⟩
  have hd : d.1 ∈ Finset.Icc 2 D ∧ l ≤ N := ⟨d.2, hl⟩
  simp only [hd, and_self, dite_true]
  exact hM d l hl s hs x

/-- The edge coefficients extended by zero outside `1 ≤ r ≤ H`. -/
def edgeExt (H : ℕ) (CE : ℕ → ∀ (v u : ι) (d : Finset.Icc 2 D), ℝ → Vec 2 →
    (PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => h u)) →L[ℝ] (PiLp 2 (fun _ : Fin 2 => h v))) :
    ℕ → ∀ (v u : ι) (d : Finset.Icc 2 D), ℝ → Vec 2 →
      (PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => h u)) →L[ℝ] (PiLp 2 (fun _ : Fin 2 => h v)) :=
  fun r v u d s => if r ∈ Finset.Icc 1 H then CE r v u d s else 0

omit P [Fintype ι] [DecidableEq ι] in
theorem edgeExt_of_mem {r : ℕ} (hr : r ∈ Finset.Icc 1 H) (v u : ι) (d : Finset.Icc 2 D) (s : ℝ) :
    edgeExt (D := D) H CE r v u d s = CE r v u d s := by
  simp [edgeExt, hr]

/-- Derivative-array bounds of the extended edge coefficients through the order `N`. -/
theorem exists_edge_bounds : ∃ BE : ι → ι → ℕ → ℕ → ℕ → ℝ, ∀ v u r (d : Finset.Icc 2 D), ∀ l,
    l ≤ N → ∀ s ∈ Set.Icc t₀ t₁, ∀ x,
      ‖coefficientDerivativeArray (edgeExt H CE r v u d s) l x‖ ≤ BE v u r d.1 l := by
  have h := fun v u r (hr : r ∈ Finset.Icc 1 H) (d : Finset.Icc 2 D) l (hl : l ≤ N) =>
    coeffArray_bound_of_seminorm P.rho_pos (P.CE_fin r hr v u d) hl
  choose M hM0 hM using h
  refine ⟨fun v u r dn l => if hd : r ∈ Finset.Icc 1 H ∧ dn ∈ Finset.Icc 2 D ∧ l ≤ N then
      M v u r hd.1 ⟨dn, hd.2.1⟩ l hd.2.2 else 0, fun v u r d l hl s hs x => ?_⟩
  by_cases hr : r ∈ Finset.Icc 1 H
  · have hd : r ∈ Finset.Icc 1 H ∧ d.1 ∈ Finset.Icc 2 D ∧ l ≤ N := ⟨hr, d.2, hl⟩
    simp only [hd, and_self, dite_true, edgeExt_of_mem hr]
    exact hM v u r hr d l hl s hs x
  · have he : edgeExt (D := D) H CE r v u d s = 0 := by simp [edgeExt, hr]
    rw [he, coefficientDerivativeArray_zero_coefficient]
    simp only [hr, false_and, dite_false]
    exact le_of_eq (ContinuousLinearMap.opNorm_zero)

end
end

/-! **The response flux of every cell** from the coarse setting: at each time of the window, the
diagonal and edge flux operators have formal adjoints on the periodic Sobolev fields, uniformly
bounded in time, acting jointly measurably; the flux of a cell is assembled from the adjoints
applied to the predecessors. -/

section
open JointOps

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {h : ι → Type*}
  [∀ i, NormedAddCommGroup (h i)] [∀ i, InnerProductSpace ℝ (h i)]
  [∀ i, FiniteDimensional ℝ (h i)] [∀ i, MeasurableSpace (h i)] [∀ i, BorelSpace (h i)]
  [∀ i, CompleteSpace (h i)]
  {t₀ t₁ ρ B a B₀ lam : ℝ} {b : ℝ → Vec 2 → Vec 2} {D H p J k L N : ℕ}
  {Jm : ℝ → Matrix (Fin 2) (Fin 2) ℝ}
  {AD : ∀ d : Finset.Icc 2 D, ℝ → Vec 2 →
    PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => ℝ) →L[ℝ] PiLp 2 (fun _ : Fin 2 => ℝ)}
  {CE : ℕ → ∀ (v u : ι) (d : Finset.Icc 2 D), ℝ → Vec 2 →
    (PiLp 2 (fun _ : DerivativeWord2 (d.1 - 1) => h u)) →L[ℝ] (PiLp 2 (fun _ : Fin 2 => h v))}
  {π : ι → ℝ} {Aedge : Matrix ι ι ℝ} {Cstar Θ : ℝ}

/-- The slot of a cell leaves room for the flux operators below the input order. -/
theorem coarseSlot_add_le (k J H L N i j : ℕ) (hN : N = k + (J + H + 3) * L) :
    coarseSlot k J H L i j + L ≤ N := by
  unfold coarseSlot
  rw [hN]
  have : (J + H + 2 - i - j) * L + L ≤ (J + H + 3) * L := by
    calc (J + H + 2 - i - j) * L + L = (J + H + 2 - i - j + 1) * L := by ring
      _ ≤ (J + H + 3) * L := Nat.mul_le_mul_right L (by omega)
  omega

/-- The smoothness of the inner edge fields, at one time of the window. -/
theorem edgeInner_contDiff
    (P : IsCoarseSetting t₀ t₁ ρ B a B₀ lam b D H p J k L N Jm AD CE π Aedge Cstar Θ)
    {M : ℝ} (hM : ∀ t ∈ Set.Icc t₀ t₁, ∀ i j, |Jm t i j| ≤ M) (v u : ι)
    {ψ : Vec 2 → PiLp 2 (fun _ : Fin 2 => h v)} (hψ : ContDiff ℝ (⊤ : ℕ∞) ψ)
    {s : ℝ} (hs : s ∈ Set.Icc t₀ t₁) :
    ContDiff ℝ ((2 * p : ℕ) : ℕ∞) (fun x => ∑ r ∈ Finset.Icc 1 H, ∑ d : Finset.Icc 2 D,
      wordAdjoint (d.1 - 1) (fun y => ContinuousLinearMap.adjoint (CE r v u d s y)
        (covPolyQ (covarianceMatrix Jm B t₀ s) p ψ y)) x) := by
  set Hc : ℝ → Matrix (Fin 2) (Fin 2) ℝ := covarianceMatrix Jm B t₀
  have hH : ∀ i j, Measurable fun s : Set.Icc t₀ t₁ => Hc s i j :=
    jo_covarianceMatrix_entries_measurable P.window B P.J_meas hM
  have hψJ : ∀ n, JMF t₀ t₁ n fun _ x => ψ x := fun n => JMF.of_contDiff hψ
  have hQ : ∀ n, JMF t₀ t₁ n fun s => covPolyQ (Hc s) p ψ :=
    fun n => JMF.cov_polyQ hH p (hψJ (n + 2 * p))
  have hL : L = D + 8 * p + 4 := P.L_eq
  have hNL : L ≤ N := by rw [P.N_eq]; nlinarith
  have hE : JMF t₀ t₁ (2 * p) fun s x => ∑ r ∈ Finset.Icc 1 H, ∑ d : Finset.Icc 2 D,
      wordAdjoint (d.1 - 1) (fun y => ContinuousLinearMap.adjoint
        (CE r v u d s y) (covPolyQ (Hc s) p ψ y)) x := by
    refine JMF.sum _ fun r hr => JMF.sum _ fun d _ => ?_
    have hd : d.1 - 1 ≤ D := by have := (Finset.mem_Icc.mp d.2).2; omega
    exact JMF.word_adjoint_adjoint ⟨P.CE_meas r hr v u d, fun s hs =>
      (P.CE_smooth r hr v u d s hs).of_le (by exact_mod_cast (by omega : 2 * p + (d.1 - 1) ≤ N))⟩
      (hQ _)
  exact hE.2 s hs

/-- **The response flux of a cell.** -/
theorem hasCellFlux_of_setting
    (P : IsCoarseSetting t₀ t₁ ρ B a B₀ lam b D H p J k L N Jm AD CE π Aedge Cstar Θ)
    {i j : ℕ} (hi : i ≤ J) (hj : j ≤ H) :
    HasCellFlux t₀ t₁ b D H p k J L AD CE (covarianceMatrix Jm B t₀) i j := by
  classical
  intro U' U'' hU' hU''
  set I := Set.Icc t₀ t₁
  set K := coarseSlot k J H L i j
  set Hc : ℝ → Matrix (Fin 2) (Fin 2) ℝ := covarianceMatrix Jm B t₀
  have hL : L = D + 8 * p + 4 := P.L_eq
  have hD2 : 2 ≤ D := P.D_ge
  have hKN : K + L ≤ N := coarseSlot_add_le k J H L N i j P.N_eq
  obtain ⟨Mj, hMj⟩ := jm_bound P
  obtain ⟨Bb, hBb⟩ := exists_drift_bounds P
  obtain ⟨BA, hBA⟩ := exists_diag_bounds P
  obtain ⟨BE, hBE⟩ := exists_edge_bounds P
  set m := 4 * p + D
  set Kc := K + m
  have hKcN : Kc + 1 ≤ N := by simp only [Kc, m]; omega
  -- the diagonal operators
  let TD : ∀ v, ℝ → (Vec 2 → PiLp 2 (fun _ : Fin 2 => h v)) → (Vec 2 → h v) :=
    fun _ s ψ x => -(coarseFluxAdjoint D b AD (Hc s) p s (covPolyQ (Hc s) p ψ) x)
  have AD' : ∀ v, ∀ s ∈ I, TorusAdj (TD v s) m 0 Kc
      (coarseFluxConst (4 * ρ ^ 2) (commConst (4 * ρ ^ 2) Kc Bb) (diagConst D Kc BA) p) :=
    fun v s hs => TorusAdj.coarseFlux (E := h v) (Hc s) (covBound_le P hs) b D p AD s 0 Kc N
      (by omega) hKcN ((P.drift_smooth s hs).of_le (by exact_mod_cast le_top))
      (P.drift_per s hs) Bb (fun l hl x => hBb l (by omega) s hs x)
      (fun d => P.AD_smooth d s hs) (fun d => P.AD_per d s hs) BA
      (fun d l hl x => hBA d l (by omega) s hs x)
  -- the edge operators
  let TE : ∀ v u, ℝ → (Vec 2 → PiLp 2 (fun _ : Fin 2 => h v)) → (Vec 2 → h u) :=
    fun v u s ψ => covPolyP (Hc s) p (fun x => ∑ r ∈ Finset.Icc 1 H, ∑ d : Finset.Icc 2 D,
      wordAdjoint (d.1 - 1) (fun y => ContinuousLinearMap.adjoint (CE r v u d s y)
        (covPolyQ (Hc s) p ψ y)) x)
  have AE' : ∀ v u, ∀ s ∈ I, TorusAdj (TE v u s) m 0 Kc
      (edgeFluxPairConst (4 * ρ ^ 2) p (edgeConst D H Kc (BE v u))) := by
    intro v u s hs
    refine (TorusAdj.edgeFluxPair (Hc s) (covBound_le P hs) D H p (edgeExt H CE) v u s 0 Kc N
      (by omega) (by omega) (fun r d => ?_) (fun r d => ?_) (BE v u)
      (fun r d l hl x => hBE v u r d l (by omega) s hs x)).ofOp ?_
    · by_cases hr : r ∈ Finset.Icc 1 H
      · rw [edgeExt_of_mem hr]; exact P.CE_smooth r hr v u d s hs
      · have he : edgeExt (D := D) H CE r v u d s = 0 := by simp [edgeExt, hr]
        rw [he]; exact contDiff_const
    · by_cases hr : r ∈ Finset.Icc 1 H
      · rw [edgeExt_of_mem hr]; exact P.CE_per r hr v u d s hs
      · have he : edgeExt (D := D) H CE r v u d s = 0 := by simp [edgeExt, hr]
        rw [he]; intro n x; rfl
    · funext ψ
      congr 1
      funext x
      refine Finset.sum_congr rfl fun r hr => Finset.sum_congr rfl fun d _ => ?_
      simp only [edgeExt_of_mem hr]
  -- joint measurability
  have hTD : ∀ v (ψ : Vec 2 → PiLp 2 (fun _ : Fin 2 => h v)), ContDiff ℝ (⊤ : ℕ∞) ψ →
      AVenhance.IsZ2Periodic ψ → JointlyMeas t₀ t₁ fun s => TD v s ψ := fun v ψ hψ _ =>
    (jo_coarseFluxAdjoint_jointlyMeas (E := h v) P.window P.drift_meas P.drift_smooth P.AD_meas
      (fun d t ht => P.AD_smooth d t ht) P.J_meas hMj (by omega) hψ).1
  have hTE : ∀ v u (ψ : Vec 2 → PiLp 2 (fun _ : Fin 2 => h v)), ContDiff ℝ (⊤ : ℕ∞) ψ →
      AVenhance.IsZ2Periodic ψ → JointlyMeas t₀ t₁ fun s => TE v u s ψ := fun v u ψ hψ _ =>
    (jo_edgeFlux_jointlyMeas P.window v u (fun r hr d => P.CE_meas r hr v u d)
      (fun r hr d t ht => P.CE_smooth r hr v u d t ht) P.J_meas hMj (by omega) hψ).1
  -- the flux
  obtain ⟨G, hG, hid⟩ := cellFlux_of_adj (F := fun v => PiLp 2 (fun _ : Fin 2 => h v))
    P.window (K := K) (K1 := coarseSlot k J H L (i - 1) j) (K2 := coarseSlot k J H L i (j - 1))
    (le_refl Kc) (le_refl Kc) i j
    (fun hi0 => by
      rw [coarseSlot_diagonal_predecessor k J H L i j (by omega) hi hj]; omega)
    (fun hj0 => by
      rw [coarseSlot_edge_predecessor k J H L i j (by omega) hi hj]; omega)
    U' U'' hU' hU'' TD TE AD' AE' hTD hTE
  refine ⟨G, hG, fun s hs ψ hψ hp => ?_⟩
  have h1 := hid s hs ψ hψ hp
  change ∑ v, cellInner (tval (G v s)) (ψ v) = _
  rw [h1]
  congr 1
  -- the edge part
  have hV : ∀ u, MemLp (predVal2 i j U'' u s) 2 (volume.restrict AVenhance.unitCube) := by
    intro u
    by_cases hj0 : j = 0
    · simp only [predVal2, hj0, ↓reduceIte]; exact memLp_const 0
    · simp only [predVal2, hj0, ↓reduceIte]; exact memLp_tval (U'' u s)
  have hcont : ∀ v u, Continuous (TE v u s (ψ v)) := fun v u =>
    (jo_edgeFlux_jointlyMeas P.window v u (fun r hr d => P.CE_meas r hr v u d)
      (fun r hr d t ht => P.CE_smooth r hr v u d t ht) P.J_meas hMj (by omega) (hψ v)).2 s hs
  have he := edge_pairing_sum (Hc s) p
    (fun v u x => ∑ r ∈ Finset.Icc 1 H, ∑ d : Finset.Icc 2 D,
      wordAdjoint (d.1 - 1) (fun y => ContinuousLinearMap.adjoint (CE r v u d s y)
        (covPolyQ (Hc s) p (ψ v) y)) x)
    (fun v u => edgeInner_contDiff P hMj v u (hψ v) hs) hcont (fun u => predVal2 i j U'' u s) hV
  change ∑ u, ∑ v, cellInner (predVal2 i j U'' u s) (TE v u s (ψ v)) = _
  rw [he]
  refine Finset.sum_congr rfl fun u _ => ?_
  rw [edgeFluxAdjoint_eq_sum]
end

end AVRegularity.CycleComparison.Coarse
end
end
end
