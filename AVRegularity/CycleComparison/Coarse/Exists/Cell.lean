open Homogenization
namespace AVRegularity.CycleComparison.Coarse

/-! Linearity of the covariance operator `Hc : ∇²` and of the covariance polynomials over finite
sums of sufficiently smooth fields, and the smoothness they consume (two derivatives per factor). -/

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem covLin_contDiff_fderiv_apply {n : ℕ} {f : Vec 2 → E}
    (hf : ContDiff ℝ ((n + 1 : ℕ) : ℕ∞) f) (e : Vec 2) :
    ContDiff ℝ (n : ℕ∞) (fun x => fderiv ℝ f x e) := by
  have h1 : ContDiff ℝ (n : ℕ∞) (fderiv ℝ f) :=
    hf.fderiv_right (by exact_mod_cast le_refl (n + 1))
  exact h1.clm_apply contDiff_const

/-- The covariance operator consumes two derivatives. -/
theorem covLin_contDiff (Hc : Matrix (Fin 2) (Fin 2) ℝ) {n : ℕ} {f : Vec 2 → E}
    (hf : ContDiff ℝ ((n + 2 : ℕ) : ℕ∞) f) : ContDiff ℝ (n : ℕ∞) (covOperator Hc f) := by
  unfold covOperator
  refine ContDiff.sum fun i _ => ContDiff.sum fun j _ => ?_
  refine contDiff_const.smul ?_
  exact covLin_contDiff_fderiv_apply (covLin_contDiff_fderiv_apply (n := n + 1) hf _) _

theorem covLin_fderiv_add {f g : Vec 2 → E} (hf : Differentiable ℝ f) (hg : Differentiable ℝ g)
    (e : Vec 2) : (fun x => fderiv ℝ (f + g) x e) = fun x => fderiv ℝ f x e + fderiv ℝ g x e := by
  funext x
  rw [fderiv_add (hf x) (hg x)]
  rfl

/-- The covariance operator is additive on `C²` fields. -/
theorem covLin_add (Hc : Matrix (Fin 2) (Fin 2) ℝ) {f g : Vec 2 → E}
    (hf : ContDiff ℝ 2 f) (hg : ContDiff ℝ 2 g) :
    covOperator Hc (f + g) = covOperator Hc f + covOperator Hc g := by
  have hf1 : Differentiable ℝ f := hf.differentiable (by norm_num)
  have hg1 : Differentiable ℝ g := hg.differentiable (by norm_num)
  have hdf : ∀ j, Differentiable ℝ (fun y => fderiv ℝ f y (basisVec j)) := fun j =>
    ((hf.fderiv_right (m := 1) (by norm_num)).clm_apply contDiff_const).differentiable (by norm_num)
  have hdg : ∀ j, Differentiable ℝ (fun y => fderiv ℝ g y (basisVec j)) := fun j =>
    ((hg.fderiv_right (m := 1) (by norm_num)).clm_apply contDiff_const).differentiable (by norm_num)
  funext x
  simp only [covOperator, Pi.add_apply]
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [covLin_fderiv_add hf1 hg1 (basisVec j)]
  have h2 : (fun y => fderiv ℝ f y (basisVec j) + fderiv ℝ g y (basisVec j)) =
      (fun y => fderiv ℝ f y (basisVec j)) + (fun y => fderiv ℝ g y (basisVec j)) := rfl
  rw [h2, fderiv_add (hdf j x) (hdg j x), add_apply, smul_add]

/-- The covariance operator vanishes on zero. -/
theorem covLin_zero (Hc : Matrix (Fin 2) (Fin 2) ℝ) : covOperator Hc (0 : Vec 2 → E) = 0 := by
  funext x
  simp [covOperator]

/-- Additivity of the iterates on `C^{2l}` fields. -/
theorem covLin_iterate_add (Hc : Matrix (Fin 2) (Fin 2) ℝ) :
    ∀ (l : ℕ) {f g : Vec 2 → E}, ContDiff ℝ ((2 * l : ℕ) : ℕ∞) f →
      ContDiff ℝ ((2 * l : ℕ) : ℕ∞) g →
      (covOperator Hc)^[l] (f + g) = (covOperator Hc)^[l] f + (covOperator Hc)^[l] g
  | 0, f, g, _, _ => rfl
  | l + 1, f, g, hf, hg => by
      rw [Function.iterate_succ_apply, Function.iterate_succ_apply, Function.iterate_succ_apply]
      have h2 : ((2 : ℕ) : WithTop ℕ∞) ≤ ((2 * (l + 1) : ℕ) : WithTop ℕ∞) := by
        exact_mod_cast (show 2 ≤ 2 * (l + 1) by omega)
      have hf2 : ContDiff ℝ 2 f := hf.of_le h2
      have hg2 : ContDiff ℝ 2 g := hg.of_le h2
      rw [covLin_add Hc hf2 hg2]
      have e : 2 * (l + 1) = 2 * l + 2 := by ring
      refine covLin_iterate_add Hc l ?_ ?_
      · exact covLin_contDiff Hc (n := 2 * l) (by rw [← e]; exact hf)
      · exact covLin_contDiff Hc (n := 2 * l) (by rw [← e]; exact hg)

/-- The iterates vanish on zero. -/
theorem covLin_iterate_zero (Hc : Matrix (Fin 2) (Fin 2) ℝ) :
    ∀ l : ℕ, (covOperator Hc)^[l] (0 : Vec 2 → E) = 0
  | 0 => rfl
  | l + 1 => by rw [Function.iterate_succ_apply, covLin_zero, covLin_iterate_zero Hc l]

/-- Additivity of the iterates over finite sums of `C^{2l}` fields. -/
theorem covLin_iterate_sum (Hc : Matrix (Fin 2) (Fin 2) ℝ) (l : ℕ) {κ : Type*} (s : Finset κ)
    {f : κ → Vec 2 → E} (hf : ∀ c ∈ s, ContDiff ℝ ((2 * l : ℕ) : ℕ∞) (f c)) :
    (covOperator Hc)^[l] (∑ c ∈ s, f c) = ∑ c ∈ s, (covOperator Hc)^[l] (f c) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [covLin_iterate_zero]
  | insert a s ha ih =>
      have hs : ContDiff ℝ ((2 * l : ℕ) : ℕ∞) (∑ c ∈ s, f c) := by
        rw [Finset.sum_fn]
        exact ContDiff.sum fun c hc => hf c (Finset.mem_insert_of_mem hc)
      rw [Finset.sum_insert ha, Finset.sum_insert ha,
        covLin_iterate_add Hc l (hf a (Finset.mem_insert_self a s)) hs,
        ih fun c hc => hf c (Finset.mem_insert_of_mem hc)]

/-- The covariance polynomial `P_p` is additive over finite sums of `C^{2p}` fields. -/
theorem covLin_covPolyP_sum (Hc : Matrix (Fin 2) (Fin 2) ℝ) (p : ℕ) {κ : Type*} (s : Finset κ)
    {f : κ → Vec 2 → E} (hf : ∀ c ∈ s, ContDiff ℝ ((2 * p : ℕ) : ℕ∞) (f c)) :
    covPolyP Hc p (∑ c ∈ s, f c) = ∑ c ∈ s, covPolyP Hc p (f c) := by
  unfold covPolyP
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun l hl => ?_
  have hl' : l ≤ p := Nat.lt_succ_iff.1 (Finset.mem_range.1 hl)
  rw [covLin_iterate_sum Hc l s fun c hc => (hf c hc).of_le (by exact_mod_cast (by omega)),
    Finset.smul_sum]

end AVRegularity.CycleComparison.Coarse
end

