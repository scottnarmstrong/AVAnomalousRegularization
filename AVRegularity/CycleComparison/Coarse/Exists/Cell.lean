/-! Causal construction of a doubly indexed family: each entry `(i, j)` is chosen from its two
predecessors `(i - 1, j)` and `(i, j - 1)` (a default value replaces a missing predecessor), by
well-founded recursion on `i + j`. If a step can always be made good and related to good
predecessors, the whole family is good and related. -/

variable {X : ℕ → ℕ → Type*} [∀ i j, Inhabited (X i j)]

/-- The first predecessor (a default value at `i = 0`). -/
def glueFst (F : ∀ i j, X i j) (i j : ℕ) : X (i - 1) j :=
  if i = 0 then default else F (i - 1) j

/-- The second predecessor (a default value at `j = 0`). -/
def glueSnd (F : ∀ i j, X i j) (i j : ℕ) : X i (j - 1) :=
  if j = 0 then default else F i (j - 1)

/-- The causal family generated by the step map. -/
def glue (step : ∀ i j, X (i - 1) j → X i (j - 1) → X i j) : ∀ i j, X i j
  | i, j => step i j (if _h : i = 0 then default else glue step (i - 1) j)
      (if _h : j = 0 then default else glue step i (j - 1))
termination_by i j => i + j
decreasing_by all_goals omega

theorem glue_eq (step : ∀ i j, X (i - 1) j → X i (j - 1) → X i j) (i j : ℕ) :
    glue step i j = step i j (glueFst (glue step) i j) (glueSnd (glue step) i j) := by
  rw [glue]
  simp only [glueFst, glueSnd, dite_eq_ite]

/-- **The causal family is good and related.** -/
theorem glue_spec (Good : ∀ i j, X i j → Prop)
    (Rel : ∀ i j, X (i - 1) j → X i (j - 1) → X i j → Prop)
    (step : ∀ i j, X (i - 1) j → X i (j - 1) → X i j)
    (hstep : ∀ i j a b, (i ≠ 0 → Good (i - 1) j a) → (j ≠ 0 → Good i (j - 1) b) →
      Good i j (step i j a b) ∧ Rel i j a b (step i j a b)) :
    ∀ i j, Good i j (glue step i j) ∧
      Rel i j (glueFst (glue step) i j) (glueSnd (glue step) i j) (glue step i j) := by
  suffices h : ∀ n, ∀ i j, i + j = n → Good i j (glue step i j) ∧
      Rel i j (glueFst (glue step) i j) (glueSnd (glue step) i j) (glue step i j) from
    fun i j => h (i + j) i j rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro i j hij
    rw [glue_eq step i j]
    refine hstep i j _ _ (fun hi => ?_) (fun hj => ?_)
    · have := (ih (i - 1 + j) (by omega) (i - 1) j rfl).1
      simpa [glueFst, hi] using this
    · have := (ih (i + (j - 1)) (by omega) i (j - 1) rfl).1
      simpa [glueSnd, hj] using this

/-- The first predecessor is the actual entry when `i ≠ 0`. -/
theorem glueFst_of_ne (F : ∀ i j, X i j) {i : ℕ} (hi : i ≠ 0) (j : ℕ) :
    glueFst F i j = F (i - 1) j := by simp [glueFst, hi]

/-- The second predecessor is the actual entry when `j ≠ 0`. -/
theorem glueSnd_of_ne (F : ∀ i j, X i j) (i : ℕ) {j : ℕ} (hj : j ≠ 0) :
    glueSnd F i j = F i (j - 1) := by simp [glueSnd, hj]

end AVRegularity.CycleComparison.Coarse
